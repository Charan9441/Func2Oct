# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Python Virtual Environments
.env
.env.*
.venv/
.venv*/
venv/
venv*/
ENV/
env/
env*/

# Testing & Linting Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Package Builds
build/
dist/
*.egg-info/

# API Credentials & Secrets
kaggle.json
*.token
access_token
secrets.*
credentials/

# Dataset files & archives (preserve directory structure with .gitkeep)
data/fundus/*
!data/fundus/.gitkeep
data/oct/*
!data/oct/.gitkeep
data/raw/*
data/staging/*
data/*.zip
kaggle_armd_*

# Model Checkpoints & Serialized Weights
checkpoints/*
!checkpoints/.gitkeep
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.onnx

# Outputs and Generated Media
outputs/synthetic_oct/*
!outputs/synthetic_oct/.gitkeep
outputs/segmentation_masks/*
!outputs/segmentation_masks/.gitkeep
outputs/evaluation_reports/*
!outputs/evaluation_reports/.gitkeep
outputs/demo_assets/*
!outputs/demo_assets/.gitkeep
*.log

# OS & Editor specific files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~
